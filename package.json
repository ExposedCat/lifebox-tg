{
	"name": "lifebox",
	"version": "1.0.0",
	"private": true,
	"description": "Daily mood tracker",
	"type": "module",
	"scripts": {
		"start": "bun src/index.ts",
		"dev": "bun --watch src/index.ts",
		"test": "bun --no-env-file test",
		"typecheck": "tsc --noEmit",
		"check": "biome check src/",
		"format": "biome format src/ --write && biome lint src/ --write"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ExposedCat/ts-tg-bot.git"
	},
	"keywords": ["telegram", "bot", "api", "typescript", "template"],
	"author": "ExposedCat",
	"license": "GPL-3.0-or-later",
	"bugs": {
		"url": "https://github.com/ExposedCat/ts-tg-bot/issues"
	},
	"homepage": "https://github.com/ExposedCat/ts-tg-bot#readme",
	"dependencies": {
		"@grammyjs/i18n": "^0.5.1",
		"@grammyjs/transformer-throttler": "^1.1.2",
		"chartjs-to-image": "^1.2.1",
		"grammy": "^1.46.0",
		"kysely": "^0.28.8",
		"node-schedule": "^2.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "latest",
		"@types/node-schedule": "^2.1.0",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.4"
	}
}
